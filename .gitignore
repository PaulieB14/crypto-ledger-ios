# Generated by `xcodegen generate` from project.yml.
# project.yml is the source of truth; the .xcodeproj is a build artifact.
# Committing it reintroduces the merge conflicts XcodeGen exists to avoid.
*.xcodeproj
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata

# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# ---------------------------------------------------------------------------
# Secrets. Nothing in this repo needs a key today, which is exactly why these
# lines go in now — the first time you wire up Coinbase OAuth or a Token API
# JWT, the ignore rule has to already be here. A key committed once lives in
# the history forever and has to be rotated, not deleted.
# ---------------------------------------------------------------------------
*.xcconfig
!Shared.xcconfig
Secrets.plist
Secrets.swift
.env
.env.*
*.p8
*.p12
*.mobileprovision
*.certSigningRequest

# local macOS SwiftUI preview harness (run without Xcode) — copied sources, not part of the app
MacPreview/
